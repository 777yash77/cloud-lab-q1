# Configuration for local testing or AWS EC2 deployment

# Replace with your EC2 Public IP or Domain (leave as localhost for local testing)
EC2_PUBLIC_IP=localhost

# Database Configuration
DB_NAME=bookstore_db
DB_USER=bookstore_user
DB_PASSWORD=bookstore_secure_password
DB_ROOT_PASSWORD=root_super_secure_password

# Public API URL for Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api
